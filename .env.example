# Jack Network — environment variables.
# Copy to .env (or set them in the panel) and fill in real values.
# Never commit a filled-in copy: .env* is gitignored except this example.

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Discord application credentials: https://discord.com/developers/applications
# Redirect URL must be exactly https://jacknetwork.in/api/auth/callback/discord
JN_AUTH_DISCORD_ID=
JN_AUTH_DISCORD_SECRET=

# Public URL of the main site. Auth.js also reads AUTH_URL; this is mirrored to it.
JN_AUTH_URL=https://jacknetwork.in

# Random 32+ characters (e.g. `openssl rand -base64 32`). Used to sign session tokens.
# Auth.js also falls back to AUTH_SECRET if this is unset.
JN_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# SQLite file. The folder is created if missing. Default on the game panel:
JN_DATABASE_URL=file:/home/container/data/app.db

# ---------------------------------------------------------------------------
# Store — session cookie (required for the store subdomain)
# ---------------------------------------------------------------------------
# Cookie domain shared by jacknetwork.in and store.jacknetwork.in. This is what
# makes single sign-on work. Must start with a dot.
JN_COOKIE_DOMAIN=.jacknetwork.in

# ---------------------------------------------------------------------------
# Store — coin economy API (owner's Discord bot)
# ---------------------------------------------------------------------------
# MINIMUM WORKING CONFIG: this plus JN_COINS_API_KEY is enough. Bare host:port
# is fine — the balance path and guild id are filled in automatically, and
# 127.0.0.1:<port> is dialled FIRST (the bot shares this machine; the public
# host cannot hairpin to itself), so the header reads balances in ~ms.
#   e.g.  power2.vektalnodes.in:19138
# Full form works too (and is what a bot on another machine should use):
#   http://power2.vektalnodes.in:19138/api/v1/economy/1537698724992647198/users/{discordId}/balance
# Use http:// only: this port has no TLS (https:// -> ERR_SSL_WRONG_VERSION_NUMBER).
JN_COINS_API_URL=

# Sent as "Authorization: Bearer <key>". Server-side only — never expose it.
JN_COINS_API_KEY=

# Optional overrides — defaults are correct for the live setup.
# Guild id used when JN_COINS_API_URL has no path (defaults to your guild):
JN_COINS_GUILD_ID=1537698724992647198
# Extra address to try if localhost and the primary both fail (e.g. a
# container IP). Localhost is already tried automatically; leave empty usually.
JN_COINS_HOST_OVERRIDE=
# Adjust endpoint. By default ".../balance" is replaced with ".../adjust" on
# the same host. {discordId} is substituted per request.
JN_COINS_ADJUST_URL=

# ---------------------------------------------------------------------------
# Store — AFK earning
# ---------------------------------------------------------------------------
# Coins awarded per completed minute on /afk (default 2).
JN_AFK_RATE=2
# Maximum coins that can be earned through /afk per UTC day (default 1440).
JN_AFK_DAILY_CAP=1440

# ---------------------------------------------------------------------------
# Store — Minecraft account linking (plugin calls /api/link/confirm)
# ---------------------------------------------------------------------------
# Shared secret the Minecraft plugin sends as "Authorization: Bearer <key>".
JN_LINK_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Minecraft server-list API used by /api/server and the status widgets.
# e.g. https://api.mcsrvstat.us/3/play.jacknetwork.in
# Also read as MINECRAFT_STATUS_URL if this one is unset.
JN_MINECRAFT_STATUS_URL=

# Google AdSense (AFK page). Both are inlined at build time, so rebuild after
# changing them. The ad renders nothing until both are set.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
