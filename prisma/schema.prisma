generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  mcLink   MinecraftLink?
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Links a website (Discord) user to an in-game Minecraft account.
/// A short-lived `code` is generated on the site, then confirmed in game.
model MinecraftLink {
  id          String    @id @default(cuid())
  userId      String    @unique
  uuid        String?   @unique
  username    String?
  code        String?   @unique
  codeExpires DateTime?
  linkedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Tracks AFK earning state per user per tab.
model AfkState {
  id        String   @id @default(cuid())
  userId    String   @unique
  tabId     String
  lastBeat  DateTime
  carry     Int      @default(0) // accumulated seconds
  seq       Int      @default(0) // incremented per credit
  day       Int      @default(0) // UTC day number (days since epoch)
  dayCoins  Int      @default(0) // coins earned this UTC day

  @@index([userId])
}
