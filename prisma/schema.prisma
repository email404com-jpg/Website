generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  mcLink   MinecraftLink?
  afk      AfkState?
  linkEvents LinkEvent[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Links a website (Discord) user to an in-game Minecraft account.
/// A short-lived `code` is generated on the site, then confirmed in game.
model MinecraftLink {
  id          String    @id @default(cuid())
  userId      String    @unique
  uuid        String?   @unique
  username    String?
  code        String?   @unique
  codeExpires DateTime?
  linkedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Audit trail of the Minecraft link lifecycle, tied to the Discord user:
/// code_issued | linked | link_refused | unlinked (source: web | plugin).
model LinkEvent {
  id        String   @id @default(cuid())
  userId    String
  uuid      String?
  username  String?
  event     String
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AfkState {
  id       String   @id @default(cuid())
  userId   String   @unique
  tabId    String
  lastBeat DateTime
  /// Milliseconds banked toward the current 60s award tick (exact — no
  /// per-gap second truncation, so the award never slips an extra interval).
  carry    Int      @default(0)
  seq      Int      @default(0)
  day      String
  dayCoins Int      @default(0)
  /// Optimistic lock for compare-and-set. A DateTime cannot be used for this:
  /// the libsql adapter matches 0 rows when a read-back DateTime is written back.
  version  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
