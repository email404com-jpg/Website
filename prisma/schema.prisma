generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  mcLink   MinecraftLink?
  afk      AfkState?
  linkEvents LinkEvent[]
  auditEvents AuditEvent[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Links a website (Discord) user to an in-game Minecraft account.
/// A short-lived `code` is generated on the site, then confirmed in game.
model MinecraftLink {
  id                  String    @id @default(cuid())
  userId              String    @unique
  uuid                String?   @unique
  username            String?
  /// One-time /link code (10 min TTL).
  code                String?   @unique
  codeExpires         DateTime?
  /// One-time /unverify code (10 min TTL), only issued while linked.
  unverifyCode        String?   @unique
  unverifyCodeExpires DateTime?
  linkedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Audit trail of the Minecraft link lifecycle, tied to the Discord user:
/// code_issued | linked | link_refused | unlinked (source: web | plugin).
model LinkEvent {
  id        String   @id @default(cuid())
  userId    String
  uuid      String?
  username  String?
  event     String
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Secret audit ledger. One row per sensitive action — verify / unverify
/// (link lifecycle) and purchases — each carrying a generated `refId`.
/// Nothing in the app reads this back: there is deliberately no API route
/// that returns `refId` or any column, so the IDs stay private to the DB.
/// `userId` is nullable + ON DELETE SET NULL so the record survives a
/// user deletion.
model AuditEvent {
  id        String   @id @default(cuid())
  /// Generated, non-sequential reference ID (e.g. "JN-7K3M9QX2").
  refId     String   @unique
  /// verify | unverify | code_issued | purchase | ...
  kind      String
  /// web | plugin | system
  source    String
  userId    String?
  uuid      String?
  username  String?
  /// Optional JSON detail (item, amount, price…) — never sent to clients.
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AfkState {
  id       String   @id @default(cuid())
  userId   String   @unique
  tabId    String
  lastBeat DateTime
  /// Milliseconds banked toward the current 60s award tick (exact — no
  /// per-gap second truncation, so the award never slips an extra interval).
  carry    Int      @default(0)
  seq      Int      @default(0)
  day      String
  dayCoins Int      @default(0)
  /// Optimistic lock for compare-and-set. A DateTime cannot be used for this:
  /// the libsql adapter matches 0 rows when a read-back DateTime is written back.
  version  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Latest proxy-reported status snapshot from the JackLink Velocity plugin
/// (`POST /api/server/report`). Single row (id = "latest").
model ServerStatus {
  id        String   @id
  /// Raw JSON: { online, players:{online,max?}, version, servers:[{name,online}] }
  payload   String
  updatedAt DateTime @updatedAt
}
